{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Scout": {
    "ChatAdapter": "Discord",
    "LlmProvider": "Ollama",
    "EnabledPlugins": [],
    "Llm": {
      "Provider": "Ollama",
      "Ollama": {
        "Endpoint": "http://localhost:11434",
        "Model": "llama3.1"
      }
    },
    "Adapters": {
      "Discord": {
        "BotToken": ""
      }
    },
    "Plugins": {
      "CloudStatus": {
        "//": "Each provider is opt-in. Remove the block or leave required fields empty to disable. Secrets go through User Secrets or SCOUT__... environment variables — never commit them here.",
        "Azure": {
          "//": "Disabled by default — uncomment and set SubscriptionId to enable. Credentials come from DefaultAzureCredential unless ClientId + ClientSecretEnvVar + TenantId are set.",
          "SubscriptionId": "",
          "TenantId": "",
          "ClientId": "",
          "ClientSecretEnvVar": ""
        },
        "OracleCloud": {
          "//": "OCI status endpoint is public — no credentials. Set Enabled to false to skip.",
          "Enabled": true,
          "StatusEndpoint": "https://ocistatus.oraclecloud.com/api/v2/summary.json",
          "Regions": [],
          "Timeout": "00:00:05"
        },
        "Aws": {
          "//": "AWS Health API requires Business or Enterprise Support on the account. Uncomment this block to enable.",
          "Region": "us-east-1",
          "Profile": ""
        },
        "Kubernetes": {
          "//": "Set UseInClusterConfig=true when running inside a pod. Otherwise set KubeconfigPath to a file (leave empty to disable).",
          "ClusterName": "default",
          "UseInClusterConfig": false,
          "KubeconfigPath": "",
          "Context": "",
          "Namespaces": [],
          "CheckNodes": true,
          "Timeout": "00:00:05"
        }
      },
      "CodeQA": {
        "//": "Leave Repository.Owner empty to keep the plugin inert. Set owner + name and export SCOUT_GITHUB_TOKEN (fine-grained PAT, Contents: Read only) to enable RAG over a single repo.",
        "Repository": {
          "Owner": "",
          "Name": "",
          "Branch": "main",
          "TokenEnvVar": "SCOUT_GITHUB_TOKEN"
        },
        "Embeddings": {
          "Provider": "Ollama",
          "Model": "nomic-embed-text",
          "BaseUrl": "http://localhost:11434",
          "HttpTimeoutSeconds": 30,
          "MaxBatchSize": 32,
          "ExpectedDimensions": 0
        },
        "VectorStore": {
          "Provider": "InMemory"
        },
        "Retrieval": {
          "TopK": 6,
          "MaxContextTokens": 4000
        },
        "Ingestion": {
          "IncludeGlobs": [ "**/*.cs", "**/*.md", "**/*.ts", "**/*.tsx" ],
          "ExcludeGlobs": [ "**/bin/**", "**/obj/**", "**/node_modules/**", "**/.git/**" ],
          "MaxFileBytes": 200000
        },
        "Chunking": {
          "ChunkTokens": 500,
          "OverlapTokens": 50,
          "ApproxBytesPerToken": 4
        },
        "Composer": {
          "Model": "",
          "MaxOutputTokens": 512,
          "Temperature": 0.2
        }
      }
    }
  }
}
