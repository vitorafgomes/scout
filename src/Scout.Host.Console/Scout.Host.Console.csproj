<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Scout.Host.Console</RootNamespace>
    <AssemblyName>Scout.Host.Console</AssemblyName>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UserSecretsId>scout-host-console</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Scout.Llm\Scout.Llm.csproj" />
    <ProjectReference Include="..\Scout.Conversation\Scout.Conversation.csproj" />
    <ProjectReference Include="..\Scout.Knowledge\Scout.Knowledge.csproj" />
    <ProjectReference Include="..\Scout.Adapter.Discord\Scout.Adapter.Discord.csproj" />
    <ProjectReference Include="..\Scout.Adapter.Slack\Scout.Adapter.Slack.csproj" />
    <ProjectReference Include="..\Scout.Adapter.Teams\Scout.Adapter.Teams.csproj" />
    <ProjectReference Include="..\Scout.Adapter.Local\Scout.Adapter.Local.csproj" />
    <ProjectReference Include="..\Scout.Plugin.GitHub\Scout.Plugin.GitHub.csproj" />
    <ProjectReference Include="..\Scout.Plugin.Kubernetes\Scout.Plugin.Kubernetes.csproj" />
    <ProjectReference Include="..\Scout.Plugin.YouTube\Scout.Plugin.YouTube.csproj" />
    <ProjectReference Include="..\Scout.Operator\Scout.Operator.csproj" />
    <ProjectReference Include="..\Scout.Transcription.Whisper\Scout.Transcription.Whisper.csproj" />
    <ProjectReference Include="..\Scout.Meetings\Scout.Meetings.csproj" />
    <ProjectReference Include="..\Scout.Audit\Scout.Audit.csproj" />
    <ProjectReference Include="..\Scout.Sandbox\Scout.Sandbox.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Scout.Host.Console.Tests" />
    <!-- Lets NSubstitute proxy internal seams (IReadinessSignal) in tests. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!-- Whisper.net loads its native libraries from runtimes/<rid>/ beside the
       binary, which a single-file publish would hide inside the bundle; keep
       the target platform's Whisper natives as loose files and drop the rest. -->
  <Target Name="ShipWhisperNativesBesideTheWorker" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <WhisperNativeDir>runtimes/$(RuntimeIdentifier.Replace('osx-', 'macos-'))/</WhisperNativeDir>
    </PropertyGroup>
    <ItemGroup>
      <_WhisperNative Include="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('runtimes/')) And $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').Contains('whisper'))" />
      <ResolvedFileToPublish Remove="@(_WhisperNative)" />
      <ResolvedFileToPublish Include="@(_WhisperNative)" Condition="$([System.String]::Copy('%(_WhisperNative.RelativePath)').Replace('\', '/').StartsWith('$(WhisperNativeDir)'))" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <ProjectReference Include="..\Scout.ControlPlane.Contracts\Scout.ControlPlane.Contracts.csproj" />
  </ItemGroup>
</Project>
