{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Scout": {
    "Llm": {
      "Provider": "Ollama",
      "Ollama": {
        "Endpoint": "http://localhost:11434",
        "Chat": {
          "Model": "qwen2.5:3b"
        },
        "Embeddings": {
          "Model": "nomic-embed-text",
          "MaxBatchSize": 16,
          "ExpectedDimensions": 0,
          "HttpTimeoutSeconds": 100
        }
      }
    },
    "Conversation": {
      "SystemPrompt": "You are Scout, a read-only chatops assistant. Answer concisely. Use plain text only - no markdown headers or code blocks unless the user explicitly asks for code.",
      "Temperature": 0.3,
      "MaxTokens": 800
    },
    "Adapters": {
      "Discord": {
        "BotToken": ""
      },
      "Slack": {
        "BotToken": "",
        "AppLevelToken": ""
      },
      "Teams": {
        "AppId": "",
        "AppPassword": "",
        "TenantId": ""
      }
    },
    "Plugins": {
      "GitHub": {
        "Token": ""
      }
    },
    "Projects": {
      "Items": []
    }
  }
}
