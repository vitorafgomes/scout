<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Scout.ControlPlane.Contracts</RootNamespace>
    <AssemblyName>Scout.ControlPlane.Contracts</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Generated protobuf/gRPC code does not carry XML docs and uses
         patterns the analyzers flag; suppress those for this project only
         so warnings-as-errors stays on everywhere else. -->
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1716;CA1724;CA2227;CA1062;CA1002;CA1819;CS8981;RS0016;IDE0005;IDE0008;IDE0058</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Server stubs for the host; client stubs for the in-process test client. -->
    <Protobuf Include="protos/providers.proto" GrpcServices="Both" />
    <Protobuf Include="protos/models.proto" GrpcServices="Both" />
    <Protobuf Include="protos/features.proto" GrpcServices="Both" />
  </ItemGroup>
</Project>
