{
  "name": "@scout/desktop-main",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/main.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build src/main.ts --target=node --outdir dist --format=esm --external electron",
    "dev:main": "NODE_ENV=development electron dist/main.js",
    "test": "bun test",
    "rebuild": "electron-rebuild --only-needed"
  },
  "dependencies": {
    "@scout/shared": "workspace:*"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/bun": "^1.4.3",
    "@types/node": "^24.19.2",
    "electron": "^45.0.0",
    "typescript": "^6.0.3"
  }
}
