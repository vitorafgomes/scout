{
  "name": "@scout/desktop-renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "build": "ng build --configuration=production",
    "build:dev": "ng build --configuration=development --watch=false",
    "dev": "ng serve --port 4200",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'handled at workspace root' && exit 0"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@scout/shared": "workspace:*",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.4.10",
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^24.0.0",
    "jsdom": "^29.0.2",
    "typescript": "~5.9.3",
    "vitest": "~5.0.5"
  }
}
